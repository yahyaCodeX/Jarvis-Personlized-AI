GEMINI_API_KEY=your-gemini-api-key
MIS_CNIC=00000-0000000-0
MIS_PASSWORD=your-mis-password

# Security settings (see safety.py)
# Folders Jarvis may read/write, separated by ;
# JARVIS_ALLOWED_DIRS=D:\Development;C:\Users\you\Desktop
JARVIS_REQUIRE_CONFIRMATION=1
JARVIS_VOICE_AUTH=1

# Gemini models, comma-separated, first = preferred (defaults in config.py)
# JARVIS_LIVE_MODELS=gemini-3.8-live,gemini-3.1-flash-live-preview
# JARVIS_VISION_MODELS=gemini-3.8-flash,gemini-3.6-flash

# Logging: DEBUG shows every Gemini packet and mic level
# JARVIS_LOG_LEVEL=INFO

# Barge-in: interrupt Jarvis by talking over it (see audio_gate.py)
# JARVIS_BARGE_IN=1                # 0 = mute the mic while Jarvis talks
# JARVIS_BARGE_IN_RATIO=3.0        # raise if Jarvis interrupts itself (laptop speakers)
# JARVIS_BARGE_IN_MIN_LEVEL=0.03

# Local model for the assignment generator and ask_local_qwen (Ollama)
# OLLAMA_MODEL=qwen2.5:7b
